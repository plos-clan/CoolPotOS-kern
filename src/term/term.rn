extern {
    pub fn flanterm_write(ctx: &mut void, buf: &u8, count: usize) void;
    pub fn flanterm_flush(ctx: &mut void) void;
    pub fn flanterm_putchar(ctx: &mut void, c: u8) void;
    pub fn flanterm_fb_init(malloc: &void, free: &void,
    framebuffer: &mut u32,
    wight: usize, 
    height: usize, 
    pitch: usize,
    red_mask_size:u8,
    red_mask_shift:u8,
    green_mask_size:u8,
    green_mask_shift:u8,
    blue_mask_size:u8,
    blue_mask_shift:u8,
    canvas: &mut u32, /* If nulled, no canvas. */
    ansi_colours: &mut u32,
    ansi_bright_colours: &mut u32, /* If nulled, default. */
    default_bg: &mut u32,
    default_fg: &mut u32, /* If nulled, default. */
    default_bg_bright: &mut u32,
    default_fg_bright: &mut u32, /* If nulled, default. */
    /* If font is null, use default font and font_width and font_height ignored. */
    font: &void,
    font_width:usize,
    font_height:usize,
    font_spacing:usize,
    /* If scale_x and scale_y are 0, automatically scale font based on resolution. */
    font_scale_x:usize,
    font_scale_y:usize,
    margin:usize,
    num_glyph: u32) &mut void;
}

use /boot.boot_framebuffer_respones;

static mut context = 0usize as &mut void;

pub fn terminal_write(text: &[u8]) void {
    if (context as usize == 0 or text.len() == 0) {
        return;
    }
    flanterm_write(context, text.ptr(), text.len());
    flanterm_flush(context);
}

pub fn terminal_put(byte: u8) void {
    if (context as usize == 0) {
        return;
    }
    flanterm_putchar(context, byte);
    flanterm_flush(context);
}

pub fn terminal_flush() void {
    if (context as usize == 0) {
        return;
    }
    flanterm_flush(context);
}

pub fn terminal_init() bool {
    let response = boot_framebuffer_respones();
    if (response as usize == 0) {
        return false;
    }
    if (response.framebuffer_count == 0 or response.framebuffers as usize == 0) {
        return false;
    }

    let framebuffer = response.framebuffers.*;
    if (framebuffer as usize == 0 or framebuffer.address as usize == 0) {
        return false;
    }

    context = flanterm_fb_init(
        0usize as &void,
        0usize as &void,
        framebuffer.address,
        framebuffer.width as usize,
        framebuffer.height as usize,
        framebuffer.pitch as usize,
        framebuffer.red_mask_size,
        framebuffer.red_mask_shift,
        framebuffer.green_mask_size,
        framebuffer.green_mask_shift,
        framebuffer.blue_mask_size,
        framebuffer.blue_mask_shift,
        0usize as &mut u32,
        0usize as &mut u32,
        0usize as &mut u32,
        0usize as &mut u32,
        0usize as &mut u32,
        0usize as &mut u32,
        0usize as &mut u32,
        0usize as &void,
        0usize, 0usize, 0usize, 0usize, 0usize, 0usize, 256
    );
    return context as usize != 0;
}
