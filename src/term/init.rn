pub mod term;

use base.io.{Writer,Printable, format_to};
use /term.term.{terminal_write,terminal_init};

type OsWriter = struct {
    
};

impl *mut OsWriter : Writer {
    pub fn write(buf: []u8) usize {
        terminal_write(buf);
        buf.len()
    }
}

static mut writer = (?*mut Writer).None;

pub fn term_init() void {
    let _ = terminal_init();
    writer = .{ Some: OsWriter.{}..& };
}

pub fn kprintf(fmt: []u8, args: []*Printable) void {
    let .{ Some: writer } = writer else @trap();
    format_to(writer, fmt, args);
}

