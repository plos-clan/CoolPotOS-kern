extern type limine_stack_size_response = struct {
    revision:u64,
};

pub extern type limine_stack_size_request = struct {
    id: [4]u64,
    revision: u64,
    response: *limine_stack_size_response,
    stack_size: u64,
};

extern type limine_video_mode = struct {
    pitch: u64,
    width: u64,
    height: u64,
    bpp: u16,
    memory_model: u8,
    red_mask_size: u8,
    red_mask_shift: u8,
    green_mask_size: u8,
    green_mask_shift: u8,
    blue_mask_size: u8,
    blue_mask_shift: u8,
};

extern type limine_framebuffer = struct {
    pub address: *u32,
    pub width: u64,
    pub height: u64,
    pub pitch: u64,
    pub bpp: u16,

    memory_model:u8,
    pub red_mask_size:u8,
    pub red_mask_shift:u8,
    pub green_mask_size:u8,
    pub green_mask_shift:u8,
    pub blue_mask_size:u8,
    pub blue_mask_shift:u8,
    unused: [7]u8,

    edid_size:u64,
    edid: *u64,
    /* Response revision 1 */
    mode_count: u64,
    modes: **limine_video_mode,
};

pub extern type limine_framebuffer_response = struct {
    revision: u64,
    pub framebuffer_count: u64,
    pub framebuffers: **limine_framebuffer,
};

pub extern type limine_framebuffer_request = struct {
    id:[4]u64,
    revision:u64,
    pub response: *limine_framebuffer_response,
};

pub type limine_memmap_type = enum {
    LIMINE_MEMMAP_USABLE = 0,
    LIMINE_MEMMAP_RESERVED = 1,
    LIMINE_MEMMAP_ACPI_RECLAIMABLE = 2,
    LIMINE_MEMMAP_ACPI_NVS = 3,
    LIMINE_MEMMAP_BAD_MEMORY = 4,
    LIMINE_MEMMAP_BOOTLOADER_RECLAIMABLE = 5,
};

pub extern type limine_memmap_entry = struct {
    pub base: u64,
    pub length: u64,
    pub ty: limine_memmap_type,
};

pub extern type limine_memmap_response = struct{
    revision: u64,
    pub entry_count: u64,
    pub entries: **limine_memmap_entry,
};

pub extern type limine_memmap_request = struct{
    id: [4]u64,
    revision: u64,
    response: *limine_memmap_response,
};

pub extern type limine_hhdm_response = struct {
    revision: u64,
    offset: u64,
};

pub extern type limine_hhdm_request = struct {
    id: [4]u64,
    revision: u64,
    response: *limine_hhdm_response,
};

