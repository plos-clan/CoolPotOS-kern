extern {
    pub fn flanterm_write(ctx: *mut void, buf: *u8, count: usize) void;
    pub fn flanterm_flush(ctx: *mut void) void;
    pub fn flanterm_putchar(ctx: *mut void, c: u8) void;
    pub fn flanterm_fb_init(malloc: *void, free: *void,
    framebuffer: *u32,
    wight: usize, 
    height: usize, 
    pitch: usize,
    red_mask_size:u8,
    red_mask_shift:u8,
    green_mask_size:u8,
    green_mask_shift:u8,
    blue_mask_size:u8,
    blue_mask_shift:u8,
    canvas: *u32, /* If nulled, no canvas. */
    ansi_colours: *u32,
    ansi_bright_colours: *u32, /* If nulled, default. */
    default_bg: *u32,
    default_fg: *u32, /* If nulled, default. */
    default_bg_bright: *u32,
    default_fg_bright: *u32, /* If nulled, default. */
    /* If font is null, use default font and font_width and font_height ignored. */
    font: *void,
    font_width:usize,
    font_height:usize,
    font_spacing:usize,
    /* If scale_x and scale_y are 0, automatically scale font based on resolution. */
    font_scale_x:usize,
    font_scale_y:usize,
    margin:usize,
    num_glyph: u32) *void;
}

use /boot.boot_framebuffer_respones;
use base.abi.cstr;

static mut context = 0 as *void;

pub fn terminal_write(text: []u8) void {
    flanterm_write(context as *mut void, text.[0].&, text.len());
}

pub fn terminal_init() void {
    let framebuffer = (boot_framebuffer_respones().framebuffers).*;
    context = flanterm_fb_init(
        0 as *void,
        0 as *void,
        framebuffer.address,
        framebuffer.width as usize,
        framebuffer.height as usize,
        framebuffer.pitch as usize,
        framebuffer.red_mask_size,
        framebuffer.red_mask_shift,
        framebuffer.green_mask_size,
        framebuffer.green_mask_shift,
        framebuffer.blue_mask_size,
        framebuffer.blue_mask_shift,
        0 as *u32,
        0 as *u32,
        0 as *u32,
        0 as *u32,
        0 as *u32,
        0 as *u32,
        0 as *u32,
        0 as *void,
        0,0,0,0,0,0,0
    );
}