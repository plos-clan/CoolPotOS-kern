mod boot;
pub mod term;
pub mod mem;
pub mod driver;
pub mod lock;

use /mem.init_frame;
use /term.{term_init,kprintf};
use /driver.serial.write_serial_str;

#[export_name("_start")]
fn kmain() void {
    term_init();
    kprintf("CoolPotOS CP_Kernel \n", .{});
    init_frame();

    while (true){
        @asm(.{
            asm: "hlt",
            volatile: true
        });
    }
}
