pub type SpinLock = struct {
    state: u8,
};

const LOCK_STATE_UNLOCKED = u8.{0};
const LOCK_STATE_LOCKED = u8.{1};

pub const SPIN_UNLOCKED = SpinLock.{ state: LOCK_STATE_UNLOCKED };
pub const SPIN_LOCKED = SpinLock.{ state: LOCK_STATE_LOCKED };

const ATOMIC_RELAXED = 0;
const ATOMIC_ACQUIRE = 1;
const ATOMIC_RELEASE = 2;

impl *mut SpinLock {
    pub fn lock() void {
        while (true) {
            let attempt = @atomicCas[u8](
                self.state..&,
                LOCK_STATE_UNLOCKED,
                LOCK_STATE_LOCKED,
                ATOMIC_ACQUIRE,
                ATOMIC_RELAXED
            );
            if (attempt.success) {
                return;
            }

            while (@atomicLoad[u8](self.state..&, ATOMIC_RELAXED) == LOCK_STATE_LOCKED) {
                @asm(.{
                    asm: "pause",
                    volatile: true
                });
            }
        }
    }

    pub fn unlock() void {
        @atomicStore[u8](self.state..&, LOCK_STATE_UNLOCKED, ATOMIC_RELEASE);
    }
}
