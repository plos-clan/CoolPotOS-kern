use /lock.{SpinLock, SPIN_UNLOCKED, spin_lock, spin_unlock};

pub type Bitmap = struct {
    lock: SpinLock,
    buffer: *u8,
    length: usize,
    bitmap_refcount: u64,
};

impl Bitmap {
    pub fn new(buffer: *u8,size: usize) Bitmap {
        return .{
            lock: SPIN_UNLOCKED,
            buffer: buffer,
            length: size * 8,
            bitmap_refcount: 1
        };
    }

    pub fn get(index: usize) bool {
        let word_index = index / 8;
        let bit_index  = index % 8;
        if (word_index > self.length) {
            return false;
        }
        return (((self.buffer + word_index).* as usize) >> bit_index) & 1 != 0;
    }

    pub fn find_range_from(length: usize, value: bool, start_from: usize) void {
        let count = 0;
        let start_index = 0;
        let byte_match = u8.{ if (value)  {-1 as u8} else  {0} };
    }
}