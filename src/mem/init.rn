mod bitmap;
pub mod page;
mod pageref;

use base.coll.range;
use /boot.{boot_hhdm_offset, boot_get_memory_map, limine_memmap_type, boot_hhdm_offset};
use /mem.page.{PAGE_SIZE, padding_up};
use /mem.bitmap.{Bitmap,bitmap_init};
use /mem.pageref.page_ref_init;
use /lock.{SpinLock, SPIN_UNLOCKED};
use /term.{dprintf,kprintf};

static mut frame_op_lock = SPIN_UNLOCKED;
static mut early_last_alloc_pos = usize.{0};
static mut physical_memory_offset = usize.{0};
static mut memory_size = usize.{0};
static mut usable_regions = Bitmap.{
    lock: SPIN_UNLOCKED,
    buffer: 0 as &mut u8,
    length: 0,
    bitmap_refcount: 1
};

pub trait FrameAllocator {
    fn alloc_frame_4k(_: usize) u64;
    fn free_frames(_: u64, _: usize) void;
};

pub union VirtAddr {
    
};

pub fn phy_to_virt(addr: usize) &mut void {
    (addr + boot_hhdm_offset()) as &mut void
}

fn get_physical_memory_size() usize {
    let mut all_memory_size = 0;
    let memory_map = boot_get_memory_map();
    for (i : range(memory_map.entry_count - 1, 0)) {
        let region = (memory_map.entries + i as usize).*;
        if (region.ty == limine_memmap_type.LIMINE_MEMMAP_USABLE) {
            all_memory_size = region.base + region.length;
            break;
        }
    }
    all_memory_size as usize
}

fn alloc_frames_early(count: usize) usize {
    if(count == 0) return 0;
    frame_op_lock..&.lock();
    let bitmap = usable_regions..&;
    let frame_index0 = bitmap.find_range_from(count, true, early_last_alloc_pos);

    let .{Some:frame_index} = frame_index0 else {
        frame_op_lock..&.unlock();
        return 0;
    };

    if(frame_index + count > bitmap.length) {
        frame_op_lock..&.unlock();
        return 0;
    }

    bitmap.set_range(frame_index, frame_index + count, false);
    early_last_alloc_pos = frame_index + count;

    frame_op_lock..&.unlock();
    return 0;
}

pub fn early_alloc(size: usize) ?&void{
    if (size == 0) return .None;

    let aligned_size = (size + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1);
    let phys = alloc_frames_early(aligned_size / PAGE_SIZE);
    if (phys == 0) return .None;

    let mut ptr = phy_to_virt(phys);
    @memset(ptr as &mut u8, 0, aligned_size);
    return .{Some:ptr};
}

pub fn get_memory_size() usize {
    return memory_size;
}

pub fn init_frame() void {
    physical_memory_offset = boot_hhdm_offset();
    memory_size = get_physical_memory_size();

    let total_frames = memory_size / PAGE_SIZE;
    let bitmap_size = (total_frames + 7) / 8;
    let bitmap_size_aligned = padding_up(bitmap_size, PAGE_SIZE);

    let mut bitmap_address = usize.{0};
    for(i : range(0 as u64, boot_get_memory_map().entry_count)) {
        let region = (boot_get_memory_map().entries + i as usize).*;
        if (region.base < 0x100000) { // x86_64 中小于 1MB 物理地址不可用
            continue;
        }
        if (region.ty == limine_memmap_type.LIMINE_MEMMAP_USABLE and region.length as usize >= bitmap_size_aligned) {
            bitmap_address = region.base as usize;
            break;
        }
    }
    if(bitmap_address == 0) {
        dprintf("Error: cannot find bitmap area.\n\r", .{});
        while (true){
            @asm(.{
                asm: "hlt",
                volatile: true
            });
        }
    }
    bitmap_init(usable_regions..& ,phy_to_virt(bitmap_address) as &mut u8,bitmap_size);

    dprintf("addr: {}\n", .{usable_regions.buffer as usize});

    for(i : range(0 as u64, boot_get_memory_map().entry_count)) {
        let region = (boot_get_memory_map().entries + i as usize).*;
        if (region.base < 0x100000) {
            continue;
        }
        if (region.ty == limine_memmap_type.LIMINE_MEMMAP_USABLE) {
            let start_frame = region.base as usize / PAGE_SIZE;
            let end_frame   = (region.base + region.length) as usize / PAGE_SIZE;
            if (end_frame > start_frame) {
                usable_regions..&.set_range(start_frame, end_frame, true);
            }
        }
    }
    
    // 保留低 1MB
    let low_1M_frames = 0x100000 / PAGE_SIZE;
    usable_regions..&.set_range(0, low_1M_frames, false);

    // 标记 bitmap 自身占用的区域为不可用
    let bitmap_frame_start = bitmap_address / PAGE_SIZE;
    let bitmap_frame_end   = padding_up(bitmap_address + bitmap_size, PAGE_SIZE) / PAGE_SIZE;
    usable_regions..&.set_range(bitmap_frame_start, bitmap_frame_end, false);

    page_ref_init();
}
