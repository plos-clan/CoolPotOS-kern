use /driver.{io_in8,io_out8};

fn write_serial0(port: u16, a: u8) void {
    while ((io_in8(port + 5) & 0x20) == 0) {
    }
    io_out8(port, a);
}

pub fn write_serial(ch: u8) void {
    write_serial0(0x3f8, ch);
}

pub fn write_serial_str(text: []u8) void {
    for(ch: text.iter()) {
        write_serial(ch);
    }
}
