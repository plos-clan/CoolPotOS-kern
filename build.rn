use craft.builder;

fn flanterm_generated_root(debug: bool) []u8 {
    if (!debug) {
        return ".craft/build/release/target/gen/coolpotos_kern-0.1.0/lib/coolpotos_kern";
    }
    return ".craft/build/dev/target/gen/coolpotos_kern-0.1.0/lib/coolpotos_kern";
}

pub fn build(b: *mut builder.Builder) void {
    if (b.unit.kind == .lib) {
        let flanterm = b.cc_config("flanterm/flanterm/flanterm.c", .{
            include_dirs: .{"flanterm/flanterm"},
            defines: .{},
            args: .{
                "-std=c11",
                "-ffreestanding",
            },
            dependencies: .{},
        });
        let fb = b.cc_config("flanterm/flanterm/flanterm_backends/fb.c", .{
            include_dirs: .{"flanterm/flanterm"},
            defines: .{},
            args: .{
                "-std=c11",
                "-ffreestanding",
            },
            dependencies: .{},
        });
        let flanterm_archive = b.stage_generated_from_tool(
            "mkarchive",
            "mkarchive",
            "libflanterm.a",
            .{
                b.paths.build_root,
                b.output_path(flanterm),
                b.output_path(fb),
            },
        );
        b.depend(flanterm_archive, flanterm);
        b.depend(flanterm_archive, fb);
        return;
    }

    if (b.unit.kind != .bin) {
        return;
    }

    b.link_arg_path("-T", "linker.ld");
    b.link_search(flanterm_generated_root(b.profile.debug));
    b.link_system_lib("flanterm");

    let kernel = b.primary_artifact();
    let kernel_image = b.stage_copy_output_to_artifact(kernel, "iso-root/kernel");
    let bios_sys = b.stage_copy_resource_file_to_artifact("limine", "limine-bios.sys", "iso-root/boot/limine-bios.sys");
    let bios_cd = b.stage_copy_resource_file_to_artifact("limine", "limine-bios-cd.bin", "iso-root/boot/limine-bios-cd.bin");
    let uefi_cd = b.stage_copy_resource_file_to_artifact("limine", "limine-uefi-cd.bin", "iso-root/boot/limine-uefi-cd.bin");
    let bootx64 = b.stage_copy_resource_file_to_artifact("limine", "BOOTX64.EFI", "iso-root/EFI/BOOT/BOOTX64.EFI");
    let limine_conf = b.stage_copy_package_file_to_artifact("assets/limine.conf", "iso-root/boot/limine.conf");

    let iso = b.stage_artifact_file_from_tool(
        "mkiso",
        "mkiso",
        "limine-smoke.iso",
        .{
            b.output_path(kernel_image),
            b.paths.build_root,
            b.resource_root("limine"),
        },
    );
    b.depend(iso, kernel_image);
    b.depend(iso, bios_sys);
    b.depend(iso, bios_cd);
    b.depend(iso, uefi_cd);
    b.depend(iso, bootx64);
    b.depend(iso, limine_conf);
}
