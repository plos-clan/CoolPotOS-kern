use base.coll.String;
use base.mem.alloc.gpa;
use std.fs;
use std.proc;
use std.mem.page;

fn write_stderr(text: &[u8]) void {
    let mut stderr = fs.stderr();
    _ = stderr..&.write_all(text);
}

fn write_stderr_line(text: &[u8]) void {
    write_stderr(text);
    write_stderr("\n");
}

fn fail(text: &[u8]) i32 {
    write_stderr_line(text);
    return 1;
}

fn push_shell_arg(out: &mut String, alloc: &mut base.mem.alloc.Allocator, arg: &[u8]) bool {
    if (out.is_empty().not() and out.try_push_char(alloc, b' ').is_ok().not()) {
        return false;
    }
    if (out.try_push_char(alloc, b'\'').is_ok().not()) {
        return false;
    }
    let mut i = 0usize;
    while (i < arg.len()) {
        if (arg.[i] == b'\'') {
            if (out.try_push_str(alloc, "'\"'\"'").is_ok().not()) {
                return false;
            }
            i += 1;
            continue;
        }
        if (out.try_push_char(alloc, arg.[i]).is_ok().not()) {
            return false;
        }
        i += 1;
    }

    return out.try_push_char(alloc, b'\'').is_ok();
}

fn run_shell(
    alloc: &mut base.mem.alloc.Allocator,
    label: &[u8],
    command: &String,
) bool {
    let .{ Ok: capture } = command.as_str().shell_capture(alloc) else {
        .{ Err: _ } => {
            write_stderr("mkarchive: failed to spawn command for ");
            write_stderr_line(label);
            return false;
        },
    };
    let mut capture = capture;
    defer capture.output..&.deinit(alloc);

    if (capture.status == 0) {
        return true;
    }

    write_stderr("mkarchive: command failed for ");
    write_stderr_line(label);
    write_stderr(command.as_str());
    write_stderr("\n");
    if (capture.output.&.is_empty().not()) {
        let output = capture.output.&.as_str();
        write_stderr(output);
        if (output.ends_with("\n").not()) {
            write_stderr("\n");
        }
    }
    return false;
}

fn archive_with_tool(
    alloc: &mut base.mem.alloc.Allocator,
    tool_name: &[u8],
    tmp_archive: &[u8],
    args: std.proc.Args,
) bool {
    let command = String.{}..&;
    defer command.deinit(alloc);

    if (command.try_push_str(alloc, tool_name).is_ok().not()
        or command.try_push_str(alloc, " rcs").is_ok().not()
        or push_shell_arg(command, alloc, tmp_archive).not())
    {
        write_stderr_line("mkarchive: failed to build archive command");
        return false;
    }

    let mut index = 2;
    while (index < args.len()) {
        let .{ Some: object_path } = args.get(index) else {
            write_stderr_line("mkarchive: missing object path argument");
            return false;
        };
        if (push_shell_arg(command, alloc, object_path).not()) {
            write_stderr_line("mkarchive: failed to append object path");
            return false;
        }
        index += 1;
    }

    run_shell(alloc, tool_name, command)
}

fn main(argc: i32, argv: &&u8) i32 {
    let page = page()..&;
    let gpa = gpa().on(page)..&;
    let args = proc.args(argc, argv);

    if (args.len() < 3) {
        return fail("usage: mkarchive <build-root> <object>...");
    }

    let .{ Some: build_root } = args.get(1) else return fail("usage: mkarchive <build-root> <object>...");

    let .{ Ok: tmp_archive } = fs.join(gpa, build_root, "mkarchive-flanterm.tmp.a") else {
        return fail("mkarchive: failed to allocate temporary archive path");
    };
    let mut tmp_archive = tmp_archive;
    let tmp_archive = tmp_archive..&;
    defer tmp_archive.deinit(gpa);

    _ = tmp_archive.as_str().path().remove_file_if_exists(gpa);

    if (archive_with_tool(gpa, "llvm-ar", tmp_archive.as_str(), args).not()
        and archive_with_tool(gpa, "ar", tmp_archive.as_str(), args).not())
    {
        _ = tmp_archive.as_str().path().remove_file_if_exists(gpa);
        return 1;
    }

    let .{ Ok: archive } = tmp_archive.as_str().path().open_read(gpa) else {
        _ = tmp_archive.as_str().path().remove_file_if_exists(gpa);
        return fail("mkarchive: failed to open generated archive");
    };
    let mut archive = archive;
    let archive = archive..&;
    defer archive.deinit();

    let mut stdout = fs.stdout();
    let .{ Ok: _ } = archive.copy_to(stdout..&) else {
        _ = tmp_archive.as_str().path().remove_file_if_exists(gpa);
        return fail("mkarchive: failed to stream archive to stdout");
    };

    _ = tmp_archive.as_str().path().remove_file_if_exists(gpa);
    return 0;
}
